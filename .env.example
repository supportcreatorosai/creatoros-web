NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: needed for protected D-ID job tracking, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=ollama
AI_TIMEOUT_MS=30000
OLLAMA_BASE_URL=http://localhost:11434
D_ID_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact additional HTTPS media hosts (comma separated; no wildcards).
MEDIA_ALLOWED_HOSTS=
# Free self-hosted video renderer (services/talking-head). When set, it is used instead of D-ID.
# Set VIDEO_PROVIDER=d-id to force D-ID while keeping these values.
TALKING_HEAD_URL=http://127.0.0.1:7861
TALKING_HEAD_TOKEN=
VIDEO_PROVIDER=
